# ==============================================================================
# Security Policy for /master/assets/uploads Directory
# ==============================================================================

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(php|php[0-9]|phtml|pht|phps|cgi|pl|py|sh|bash|exe|bat|cmd|dll|bin|com|vbs|msi|jsp|asp|aspx)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
