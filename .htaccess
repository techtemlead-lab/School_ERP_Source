Options -Indexes
RewriteEngine On
RewriteRule ^teacher/(?!(?:index|login|captcha_refresh)\.php$)[^/]+\.php$ - [F,L]
RewriteRule ^student/(?!(?:index|login|captcha_refresh|fee_payment_init|fee_payment_callback|live_class_status)\.php$)[^/]+\.php$ - [F,L]
RewriteRule ^(?:config|sql|cron|tests|deployment)(?:/|$) - [F,L]
RewriteRule ^(?:\.env|\.git|\.user\.ini)(?:/|$) - [F,L]
RewriteRule ^uploads/.*\.(?:php[0-9]*|phtml|phar|cgi|pl|html?|svg|js)$ - [F,L,NC]
RewriteRule ^uploads/demo/(.*)$ demo/file.php?path=uploads/demo/$1 [QSA,L]
RewriteRule ^demo/?$ demo/index.php [L]
<FilesMatch "(?i)\.(sql|log|ini|md|bak|zip|env|sh|yml)$">
    Require all denied
</FilesMatch>
