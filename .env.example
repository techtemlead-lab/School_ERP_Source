# ==============================================================================
# School Management ERP — Production Environment Configuration (.env.example)
# Duplicate this file to '.env' on your production server and update credentials.
# ==============================================================================

# Application Environment (production / development / staging)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Master Multi-Tenant Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_master_db
DB_USER=cpanel_master_user
DB_PASS=YourStrongMasterPasswordHere

# Demo Tenant Sandbox Database
DEMO_DB_HOST=127.0.0.1
DEMO_DB_NAME=school_demo
DEMO_DB_USER=cpanel_demo_user
DEMO_DB_PASS=YourStrongDemoPasswordHere

# Security Secret Keys
DEMO_RESET_KEY=demo_reset_secret_2026
SESSION_LIFETIME=7200

# Default SMS Gateway Settings (Optional fallback)
SMS_ENABLED=false
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=
